#
# LevelDB support
#
ifeq (${USE_LEVELDB}, 1)
LIBS += $(CURDIR)/leveldb/libleveldb.a $(CURDIR)/leveldb/libmemenv.a
DEFS += $(addprefix -I,$(CURDIR)/leveldb/include) -DUSE_LEVELDB
DEFS += $(addprefix -I,$(CURDIR)/leveldb/helpers)
OBJS += obj/txdb-leveldb.o
# FORCE, not a prerequisite list: enumerating LevelDB's sources here would drift the
# same way the IV5 archive's list did. Descend every time and let the nested make,
# which does track its own sources, decide whether anything needs rebuilding.
leveldb/libleveldb.a: FORCE
	@echo "Building LevelDB ..."
	+$(MAKE) -C leveldb CC="$(CC)" CXX="$(CXX)" \
		CFLAGS="$(CFLAGS)" CXXFLAGS="$(CXXFLAGS)" LDFLAGS="$(LDFLAGS)" \
		libleveldb.a libmemenv.a
obj/txdb-leveldb.o: leveldb/libleveldb.a
endif
ifneq (${USE_LEVELDB}, 1)
OBJS += obj/txdb-bdb.o
endif

# auto-generated dependencies:
# Keep nested test/minizip objects header-correct.  Omitting obj/test/*.P can
# silently link ABI-stale tests after a consensus/proof header changes.
-include obj/*.P obj/*/*.P

obj/build.h: FORCE
	/bin/sh ../share/genbuild.sh obj/build.h
version.cpp: obj/build.h
# version.o carries BUILD_DESC, which the release gate trusts to say which commit
# a binary was built from. The generated .P names build.h, but a parallel build can
# compile version.o before the FORCE rule rewrites it, leaving the binary reporting
# a commit it was not built from. State the order.
obj/version.o: obj/build.h
DEFS += -DHAVE_BUILD_INFO

obj/scrypt-x86_64.o: scrypt-x86_64.S
	$(CXX) -c $(CFLAGS) -MMD -o $@ $<

obj/%.o: %.c
	@mkdir -p $(@D)
	$(CC) -c $(CFLAGS) -MMD -MF $(@:%.o=%.d) -o $@ $<
	@cp $(@:%.o=%.d) $(@:%.o=%.P); \
	sed -e 's/#.*//' -e 's/^[^:]*: *//' -e 's/ *\\$$//' \
	-e '/^$$/ d' -e 's/$$/ :/' < $(@:%.o=%.d) >> $(@:%.o=%.P); \
	rm -f $(@:%.o=%.d)

obj/minizip/%.o: minizip/%.c
	@mkdir -p obj/minizip
	$(CC) -c $(CFLAGS) -MMD -MF $(@:%.o=%.d) -o $@ $<
	@cp $(@:%.o=%.d) $(@:%.o=%.P); \
	sed -e 's/#.*//' -e 's/^[^:]*: *//' -e 's/ *\\$$//' \
	-e '/^$$/ d' -e 's/$$/ :/' < $(@:%.o=%.d) >> $(@:%.o=%.P); \
	rm -f $(@:%.o=%.d)

obj/%.o: %.cpp
	@mkdir -p $(@D)
	$(CXX) -c $(CXXFLAGS) -MMD -MF $(@:%.o=%.d) -o $@ $<
	@cp $(@:%.o=%.d) $(@:%.o=%.P); \
		sed -e 's/#.*//' -e 's/^[^:]*: *//' -e 's/ *\\$$//' \
		-e '/^$$/ d' -e 's/$$/ :/' < $(@:%.o=%.d) >> $(@:%.o=%.P); \
	rm -f $(@:%.o=%.d)

obj/%.o: json/%.cpp
	$(CXX) -c $(CXXFLAGS) -MMD -MF $(@:%.o=%.d) -o $@ $<
	@cp $(@:%.o=%.d) $(@:%.o=%.P); \
	sed -e 's/#.*//' -e 's/^[^:]*: *//' -e 's/ *\\$$//' \
	-e '/^$$/ d' -e 's/$$/ :/' < $(@:%.o=%.d) >> $(@:%.o=%.P); \
	rm -f $(@:%.o=%.d)

obj/%.o: %.cc
	$(CXX) -c $(CXXFLAGS) -MMD -MF $(@:%.o=%.d) -o $@ $<
	@cp $(@:%.o=%.d) $(@:%.o=%.P); \
	sed -e 's/#.*//' -e 's/^[^:]*: *//' -e 's/ *\\$$//' \
	-e '/^$$/ d' -e 's/$$/ :/' < $(@:%.o=%.d) >> $(@:%.o=%.P); \
	rm -f $(@:%.o=%.d)

PRIVACY_VNEXT_RUST_DIR := $(CURDIR)/privacy_vnext/rust
# The vendored proof library is a dependency, not the code under test, so it is
# built optimized even for debug builds of the daemon: unoptimized, its proof
# math put the unit suite over an hour, which is long enough that a release gate
# gets skipped. Set PRIVACY_VNEXT_RUST_DEBUG=1 to step through the crate itself.
PRIVACY_VNEXT_RUST_PROFILE := release
PRIVACY_VNEXT_RUST_FLAGS := --release
ifdef PRIVACY_VNEXT_RUST_DEBUG
PRIVACY_VNEXT_RUST_PROFILE := debug
PRIVACY_VNEXT_RUST_FLAGS :=
endif
PRIVACY_VNEXT_RUST_LIB := $(PRIVACY_VNEXT_RUST_DIR)/target/$(PRIVACY_VNEXT_RUST_PROFILE)/libinnova_privacy_vnext.a
# Cargo is the freshness authority here: it tracks the crate's own sources and
# the seven path dependencies under upstream/. A hand-written prerequisite list
# covered neither and linked a stale consensus decoder. A no-op build leaves the
# archive's timestamp alone, so this does not force a relink.
$(PRIVACY_VNEXT_RUST_LIB): FORCE
	cd $(PRIVACY_VNEXT_RUST_DIR) && cargo build --locked --offline $(PRIVACY_VNEXT_RUST_FLAGS)

innovad: $(OBJS:obj/%=obj/%) $(PRIVACY_VNEXT_RUST_LIB)
	$(CXX) $(CXXFLAGS) $(LDFLAGS) -o $@ $^ $(LIBS) -framework CoreFoundation -framework IOKit

test_innova: $(filter-out obj/init.o,$(OBJS:obj/%=obj/%)) $(TEST_OBJS) $(PRIVACY_VNEXT_RUST_LIB)
	$(CXX) $(CXXFLAGS) $(LDFLAGS) -o $@ $^ $(LIBS) -lboost_unit_test_framework -framework CoreFoundation -framework IOKit

clean:
	rm -f innovad
	rm -f test_innova
	rm -f $(FUZZ_DESERIALIZE_BIN)
	rm -f obj/*.o
	rm -f obj/*.P
	rm -f obj/*.d
	rm -f obj/test/*.o
	rm -f obj/test/*.P
	rm -f obj/test/*.d
	rm -rf obj/fuzz
	rm -f obj/build.h
	rm -rf obj/minizip
	+$(MAKE) -C leveldb clean

FORCE:
