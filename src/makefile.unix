# The suite reads its JSON vectors from src/test/data.  Compiling the absolute
# path in keeps that resolution independent of the caller's working directory.
TESTDEFS = -DTEST_DATA_DIR=$(abspath test/data)
obj/test/%.o: override CXXFLAGS += $(TESTDEFS)
# The .P files record header dependencies, not flags, so a changed TESTDEFS would
# otherwise leave a stale binary behind.
$(TEST_OBJS): makefile.unix

FUZZ_CXX ?= clang++
FUZZ_COMPILE_FLAGS ?= -O1 -g -fsanitize=fuzzer-no-link,address,undefined -fno-omit-frame-pointer
FUZZ_LINK_FLAGS ?= -O1 -g -fsanitize=fuzzer,address,undefined -fno-omit-frame-pointer
FUZZ_DESERIALIZE_BIN ?= fuzz_deserialize
FUZZ_DESERIALIZE_OBJ ?= obj/fuzz/fuzz_deserialize.o

.PHONY: all innova-build audit-test-dependencies check-build-source-parity fuzz-deserialize fuzz-deserialize-libfuzzer check-legacy-aggregate check-bpac check-finality-tally check-fcmp check-idag-validation check-dag-parent-commitment check-shielded-nullifier-binding check-finality-vote-binding check-nullsend-binding check-coinstake-guard check-cn-payment-verdict check-coldstake-cn-payee check-cn-pow-payment check-cn-selection check-nullstake-finality-only check-retarget check-blockindex-nsize check-finality-committee-sig check-halfagg-stake check-epoch-state-determinism check-dag-privacy-interaction check-dagknight-anchor-cache check-finality-settlement check-finality-note check-privacy-vnext check-privacy-vnext-mask-pinning check-privacy-vnext-change-rotation check-name-index-recovery check-name-rental check-fuzz-deserialize-limits check-smessage-hmac check-emission-curve check-emission-schedule-walk check-finality-coldstart check-finality-vote-schedule check-privacy-vnext-provenance check-privacy-vnext-freshness check-all release-check check-cn-rescan check-finality-vote-lane check-idag-rule-coverage check-dag-index-extractor check-nullifier-binding-consensus check-shielded-pool-reorg check-shielded-coinstake-input check-nullstake-reclaim-gate check-reorg-finality-anchor check-idag-connect-rule check-iv5-privacy-coverage check-nullstake-generation-gate check-drift-fork-rule check-settlement-headroom-clamp check-block-inv-response check-block-spacing-floor check-idns-privacy check-idns-rendezvous check-collateralnode-privacy check-ms-timestamp check-ms-timestamp-index

INNOVA_SPINNER ?= 1
INNOVA_SPINNER_SCRIPT ?= ../contrib/innova_build_spinner.sh

ifeq ($(INNOVA_SPINNER),1)
all:
	@$(INNOVA_SPINNER_SCRIPT) $(MAKE) -f makefile.unix INNOVA_SPINNER=0 innova-build
else
all: innova-build
endif

innova-build: innovad

audit-test-dependencies:
	../contrib/test/audit_build_dependencies.sh

# The GUI and the daemon keep separate source lists; drift between them silently
# drops a source from one build. That is how the v5 privacy layer left the GUI.
check-build-source-parity:
	python3 ../contrib/test/check_build_source_parity.py

# The vendored crate set and the pinned ABI are consensus inputs, so a release
# build has to prove them rather than assume them.
check-privacy-vnext-provenance:
	python3 privacy_vnext/rust/tools/verify_provenance.py

# Belt-and-braces against the rule that produces the archive being wrong again: this
# reads mtimes, not the dependency graph, so a bad prerequisite list cannot hide from it.
check-privacy-vnext-freshness:
	PRIVACY_VNEXT_RUST_PROFILE=$(PRIVACY_VNEXT_RUST_PROFILE) \
	    ../contrib/test/check_privacy_vnext_freshness.sh

fuzz-deserialize: $(FUZZ_DESERIALIZE_OBJ)

$(FUZZ_DESERIALIZE_OBJ): test/fuzz/fuzz_deserialize.cpp
	@mkdir -p $(@D)
	$(FUZZ_CXX) $(filter-out -D_FORTIFY_SOURCE=2,$(xCXXFLAGS)) $(FUZZ_COMPILE_FLAGS) -DINNOVA_FUZZ_STANDALONE -MMD -MF $(@:%.o=%.d) -c -o $@ $<

fuzz-deserialize-libfuzzer:
	$(FUZZ_CXX) $(filter-out -D_FORTIFY_SOURCE=2,$(xCXXFLAGS)) $(FUZZ_LINK_FLAGS) -DINNOVA_FUZZ_STANDALONE -o $(FUZZ_DESERIALIZE_BIN) test/fuzz/fuzz_deserialize.cpp

FUZZ_SCRIPT_BIN ?= fuzz_script
FUZZ_BLOCK_HEADER_BIN ?= fuzz_block_header

# fuzz_script.cpp exercises real CScript/Solver behavior, so the implementation
# must be compiled in alongside it, instrumented with the same flags.
FUZZ_SCRIPT_SRCS ?= test/fuzz/fuzz_script.cpp test/fuzz/fuzz_stubs.cpp script.cpp key.cpp hash.cpp util.cpp netbase.cpp sync.cpp keystore.cpp crypter.cpp version.cpp noui.cpp scrypt.cpp pbkdf2.cpp

fuzz-script-libfuzzer:
	$(FUZZ_CXX) $(filter-out -D_FORTIFY_SOURCE=2,$(xCXXFLAGS)) $(FUZZ_LINK_FLAGS) -DINNOVA_FUZZ_STANDALONE -o $(FUZZ_SCRIPT_BIN) $(FUZZ_SCRIPT_SRCS) $(LIBS)

# The header hash is Tribus (jh + keccak + echo). Those are C sources and must be
# compiled as C; feeding them to the C++ driver breaks overload resolution.
FUZZ_CC ?= clang
FUZZ_BLOCK_HEADER_SRCS ?= test/fuzz/fuzz_block_header.cpp test/fuzz/fuzz_stubs.cpp util.cpp netbase.cpp sync.cpp version.cpp noui.cpp
FUZZ_TRIBUS_SRCS ?= jh.c keccak.c echo.c
FUZZ_TRIBUS_OBJS ?= obj/fuzz/jh.o obj/fuzz/keccak.o obj/fuzz/echo.o

obj/fuzz/%.o: %.c
	@mkdir -p $(@D)
	$(FUZZ_CC) $(filter-out -D_FORTIFY_SOURCE=2,$(xCFLAGS)) $(FUZZ_COMPILE_FLAGS) -c -o $@ $<

fuzz-block-header-libfuzzer: $(FUZZ_TRIBUS_OBJS)
	$(FUZZ_CXX) $(filter-out -D_FORTIFY_SOURCE=2,$(xCXXFLAGS)) $(FUZZ_LINK_FLAGS) -DINNOVA_FUZZ_STANDALONE -o $(FUZZ_BLOCK_HEADER_BIN) $(FUZZ_BLOCK_HEADER_SRCS) $(FUZZ_TRIBUS_OBJS) $(LIBS)

# The privacy ABI is a pure function of peer bytes, so its target links the Rust
# archive and the header only -- no daemon sources, no globals, no node state. The
# rule itself sits with PRIVACY_VNEXT_RUST_LIB below, because make expands a
# prerequisite list when it reads the rule and the variable is defined further down.
FUZZ_PRIVACY_PAYLOAD_BIN ?= fuzz_privacy_payload
FUZZ_PRIVACY_PAYLOAD_SRCS ?= test/fuzz/fuzz_privacy_payload.cpp
FUZZ_PRIVACY_REPLAY_BIN ?= fuzz_privacy_replay
FUZZ_PRIVACY_REPLAY_SRCS ?= test/fuzz/fuzz_privacy_replay.cpp

fuzz-all-libfuzzer: fuzz-deserialize-libfuzzer fuzz-script-libfuzzer fuzz-block-header-libfuzzer fuzz-privacy-payload-libfuzzer

check-legacy-aggregate: test_innova
	./test_innova --run_test=allocator_tests,base32_tests,base58_tests,base64_tests,bignum_tests,Checkpoints_tests,DoS_tests,getarg_tests,key_tests,mruset_tests,multisig_tests,netbase_tests,ringsig_tests,rpc_tests,script_P2SH_tests,script_tests,sigopcount_tests,transaction_tests,uint160_tests,uint256_tests,util_tests,wallet_tests,accounting_tests,miner_tests

