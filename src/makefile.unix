# suites: shielded_nullifier_binding_tests.cpp defines two and test_innova.cpp
# defines none. Running the binary with no --run_test filter takes the executed
# set from the linked binary instead of from a list kept beside it, so a suite
# that is compiled cannot go unrun.
check-all: test_innova
	./test_innova

