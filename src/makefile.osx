# The suite reads its JSON vectors from src/test/data.  Compiling the absolute
# path in keeps that resolution independent of the caller's working directory.
TESTDEFS = -DTEST_DATA_DIR=$(abspath test/data)
obj/test/%.o: override CXXFLAGS += $(TESTDEFS)
# The .P files record header dependencies, not flags, so a changed TESTDEFS would
# otherwise leave a stale binary behind.
$(TEST_OBJS): makefile.osx

FUZZ_CXX ?= clang++
FUZZ_COMPILE_FLAGS ?= -O1 -g -fsanitize=fuzzer-no-link,address,undefined -fno-omit-frame-pointer
FUZZ_LINK_FLAGS ?= -O1 -g -fsanitize=fuzzer,address,undefined -fno-omit-frame-pointer
FUZZ_DESERIALIZE_BIN ?= fuzz_deserialize
FUZZ_DESERIALIZE_OBJ ?= obj/fuzz/fuzz_deserialize.o

.PHONY: all innova-build audit-test-dependencies check-build-source-parity fuzz-deserialize fuzz-deserialize-libfuzzer check-legacy-aggregate check-bpac check-finality-tally check-fcmp check-idag-validation check-dag-parent-commitment check-shielded-nullifier-binding check-finality-vote-binding check-nullsend-binding check-coinstake-guard check-cn-payment-verdict check-coldstake-cn-payee check-cn-pow-payment check-cn-selection check-blockindex-nsize check-emission-curve check-emission-schedule-walk check-finality-coldstart check-finality-committee-sig check-halfagg-stake check-epoch-state-determinism check-dag-privacy-interaction check-finality-settlement check-finality-vote-schedule check-finality-note check-privacy-vnext check-privacy-vnext-mask-pinning check-privacy-vnext-change-rotation check-name-index-recovery check-name-rental check-fuzz-deserialize-limits check-smessage-hmac check-all release-check check-privacy-vnext-provenance check-privacy-vnext-freshness check-cn-rescan check-finality-vote-lane check-idag-rule-coverage check-dag-index-extractor check-nullifier-binding-consensus check-shielded-pool-reorg check-shielded-coinstake-input check-nullstake-reclaim-gate check-reorg-finality-anchor check-idag-connect-rule check-iv5-privacy-coverage check-nullstake-generation-gate check-drift-fork-rule check-settlement-headroom-clamp check-block-inv-response check-block-spacing-floor check-idns-privacy check-idns-rendezvous check-collateralnode-privacy check-ms-timestamp check-ms-timestamp-index

INNOVA_SPINNER ?= 1
INNOVA_SPINNER_SCRIPT ?= ../contrib/innova_build_spinner.sh

ifeq ($(INNOVA_SPINNER),1)
all:
	@$(INNOVA_SPINNER_SCRIPT) $(MAKE) -f makefile.osx INNOVA_SPINNER=0 innova-build
else
all: innova-build
endif

innova-build: innovad

audit-test-dependencies:
	../contrib/test/audit_build_dependencies.sh

# The GUI and the daemon keep separate source lists; drift between them silently
# drops a source from one build. That is how the v5 privacy layer left the GUI.
check-build-source-parity:
	python3 ../contrib/test/check_build_source_parity.py

# The vendored crate set and the pinned ABI are consensus inputs, so a release
# build has to prove them rather than assume them.
check-privacy-vnext-provenance:
	python3 privacy_vnext/rust/tools/verify_provenance.py

# Belt-and-braces against the rule that produces the archive being wrong again: this
# reads mtimes, not the dependency graph, so a bad prerequisite list cannot hide from it.
check-privacy-vnext-freshness:
	PRIVACY_VNEXT_RUST_PROFILE=$(PRIVACY_VNEXT_RUST_PROFILE) \
	    ../contrib/test/check_privacy_vnext_freshness.sh

fuzz-deserialize: $(FUZZ_DESERIALIZE_OBJ)

$(FUZZ_DESERIALIZE_OBJ): test/fuzz/fuzz_deserialize.cpp
	@mkdir -p $(@D)
	$(FUZZ_CXX) $(filter-out -D_FORTIFY_SOURCE=2,$(CXXFLAGS)) $(FUZZ_COMPILE_FLAGS) -DINNOVA_FUZZ_STANDALONE -MMD -MF $(@:%.o=%.d) -c -o $@ $<

fuzz-deserialize-libfuzzer:
	$(FUZZ_CXX) $(filter-out -D_FORTIFY_SOURCE=2,$(CXXFLAGS)) $(FUZZ_LINK_FLAGS) -DINNOVA_FUZZ_STANDALONE -o $(FUZZ_DESERIALIZE_BIN) test/fuzz/fuzz_deserialize.cpp

check-legacy-aggregate: test_innova
	./test_innova --run_test=allocator_tests,base32_tests,base58_tests,base64_tests,bignum_tests,Checkpoints_tests,DoS_tests,getarg_tests,key_tests,mruset_tests,multisig_tests,netbase_tests,ringsig_tests,rpc_tests,script_P2SH_tests,script_tests,sigopcount_tests,transaction_tests,uint160_tests,uint256_tests,util_tests,wallet_tests,accounting_tests,miner_tests

