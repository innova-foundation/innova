FUZZ_CXX ?= clang++
FUZZ_COMPILE_FLAGS ?= -O1 -g -fsanitize=fuzzer-no-link,address,undefined -fno-omit-frame-pointer
FUZZ_LINK_FLAGS ?= -O1 -g -fsanitize=fuzzer,address,undefined -fno-omit-frame-pointer
FUZZ_DESERIALIZE_BIN ?= fuzz_deserialize
FUZZ_DESERIALIZE_OBJ ?= obj/fuzz/fuzz_deserialize.o

.PHONY: all innova-build audit-test-dependencies fuzz-deserialize fuzz-deserialize-libfuzzer check-legacy-aggregate check-bpac check-finality-tally check-fcmp check-idag-validation check-shielded-nullifier-binding check-finality-vote-binding check-nullsend-binding check-coinstake-guard check-retarget check-finality-committee-sig check-halfagg-stake check-epoch-state-determinism check-dagknight-anchor-cache check-finality-settlement check-finality-note check-privacy-vnext check-name-index-recovery check-name-rental check-fuzz-deserialize-limits check-smessage-hmac check-emission-curve check-finality-coldstart check-finality-vote-schedule check-privacy-vnext-provenance check-privacy-vnext-freshness check-all release-check

INNOVA_SPINNER ?= 1
INNOVA_SPINNER_SCRIPT ?= ../contrib/innova_build_spinner.sh

ifeq ($(INNOVA_SPINNER),1)
all:
	@$(INNOVA_SPINNER_SCRIPT) $(MAKE) -f makefile.unix INNOVA_SPINNER=0 innova-build
else
all: innova-build
endif

innova-build: innovad

audit-test-dependencies:
	../contrib/test/audit_build_dependencies.sh

# The vendored crate set and the pinned ABI are consensus inputs, so a release
# build has to prove them rather than assume them.
check-privacy-vnext-provenance:
	python3 privacy_vnext/rust/tools/verify_provenance.py

# Belt-and-braces against the rule that produces the archive being wrong again: this
# reads mtimes, not the dependency graph, so a bad prerequisite list cannot hide from it.
check-privacy-vnext-freshness:
	PRIVACY_VNEXT_RUST_PROFILE=$(PRIVACY_VNEXT_RUST_PROFILE) \
	    ../contrib/test/check_privacy_vnext_freshness.sh

fuzz-deserialize: $(FUZZ_DESERIALIZE_OBJ)

$(FUZZ_DESERIALIZE_OBJ): test/fuzz/fuzz_deserialize.cpp
	@mkdir -p $(@D)
	$(FUZZ_CXX) $(filter-out -D_FORTIFY_SOURCE=2,$(xCXXFLAGS)) $(FUZZ_COMPILE_FLAGS) -DINNOVA_FUZZ_STANDALONE -MMD -MF $(@:%.o=%.d) -c -o $@ $<

fuzz-deserialize-libfuzzer:
	$(FUZZ_CXX) $(filter-out -D_FORTIFY_SOURCE=2,$(xCXXFLAGS)) $(FUZZ_LINK_FLAGS) -DINNOVA_FUZZ_STANDALONE -o $(FUZZ_DESERIALIZE_BIN) test/fuzz/fuzz_deserialize.cpp

FUZZ_SCRIPT_BIN ?= fuzz_script
FUZZ_BLOCK_HEADER_BIN ?= fuzz_block_header

# fuzz_script.cpp exercises real CScript/Solver behavior, so the implementation
# must be compiled in alongside it, instrumented with the same flags.
FUZZ_SCRIPT_SRCS ?= test/fuzz/fuzz_script.cpp test/fuzz/fuzz_stubs.cpp script.cpp key.cpp hash.cpp util.cpp netbase.cpp sync.cpp keystore.cpp crypter.cpp version.cpp noui.cpp scrypt.cpp pbkdf2.cpp

fuzz-script-libfuzzer:
	$(FUZZ_CXX) $(filter-out -D_FORTIFY_SOURCE=2,$(xCXXFLAGS)) $(FUZZ_LINK_FLAGS) -DINNOVA_FUZZ_STANDALONE -o $(FUZZ_SCRIPT_BIN) $(FUZZ_SCRIPT_SRCS) $(LIBS)

# The header hash is Tribus (jh + keccak + echo). Those are C sources and must be
# compiled as C; feeding them to the C++ driver breaks overload resolution.
FUZZ_CC ?= clang
FUZZ_BLOCK_HEADER_SRCS ?= test/fuzz/fuzz_block_header.cpp test/fuzz/fuzz_stubs.cpp util.cpp netbase.cpp sync.cpp version.cpp noui.cpp
FUZZ_TRIBUS_SRCS ?= jh.c keccak.c echo.c
FUZZ_TRIBUS_OBJS ?= obj/fuzz/jh.o obj/fuzz/keccak.o obj/fuzz/echo.o

obj/fuzz/%.o: %.c
	@mkdir -p $(@D)
	$(FUZZ_CC) $(filter-out -D_FORTIFY_SOURCE=2,$(xCFLAGS)) $(FUZZ_COMPILE_FLAGS) -c -o $@ $<

fuzz-block-header-libfuzzer: $(FUZZ_TRIBUS_OBJS)
	$(FUZZ_CXX) $(filter-out -D_FORTIFY_SOURCE=2,$(xCXXFLAGS)) $(FUZZ_LINK_FLAGS) -DINNOVA_FUZZ_STANDALONE -o $(FUZZ_BLOCK_HEADER_BIN) $(FUZZ_BLOCK_HEADER_SRCS) $(FUZZ_TRIBUS_OBJS) $(LIBS)

fuzz-all-libfuzzer: fuzz-deserialize-libfuzzer fuzz-script-libfuzzer fuzz-block-header-libfuzzer

