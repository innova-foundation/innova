USE_LEVELDB:=1
USE_UPNP:=1
USE_NATIVETOR:=1
USE_IPFS:=1
UNAME_S := $(shell uname -s)
HOMEBREW_PREFIX := $(shell brew --prefix 2>/dev/null)
# brew --prefix answers with a path whether or not the formula is installed, so
# select on the header being present instead. 5 is tried first: that is what the
# Linux build links against.
BDB_BREW_PREFIX := $(shell for f in berkeley-db@5 berkeley-db@4 berkeley-db; do \
    p=$$(brew --prefix $$f 2>/dev/null); \
    if [ -f "$$p/include/db_cxx.h" ]; then echo "$$p"; break; fi; \
  done)

LINK:=$(CXX)
UNAME_M := $(shell uname -m)
ARCH:=$(shell lscpu 2>/dev/null | head -n 1 | awk '{print $$2}')

DEFS=-DBOOST_SPIRIT_THREADSAFE

DEFS += $(addprefix -I,$(CURDIR) $(CURDIR)/obj $(CURDIR)/json $(BOOST_INCLUDE_PATH) $(BDB_INCLUDE_PATH) $(OPENSSL_INCLUDE_PATH))
OPENSSL_PKGCONF := $(shell pkg-config --cflags openssl 2>/dev/null)
ifneq ($(OPENSSL_PKGCONF),)
    DEFS += $(OPENSSL_PKGCONF)
endif
LIBEVENT_PKGCONF := $(shell pkg-config --cflags libevent 2>/dev/null)
ifneq ($(LIBEVENT_PKGCONF),)
    DEFS += $(LIBEVENT_PKGCONF)
endif
LIBS = $(addprefix -L,$(BOOST_LIB_PATH) $(BDB_LIB_PATH) $(OPENSSL_LIB_PATH))

DEFS += -DIS_ARCH_64

ifneq ($(HOMEBREW_PREFIX),)
    DEFS += -I$(HOMEBREW_PREFIX)/include
    LIBS += -L$(HOMEBREW_PREFIX)/lib
endif
ifneq ($(BDB_BREW_PREFIX),)
    DEFS += -I$(BDB_BREW_PREFIX)/include
    LIBS += -L$(BDB_BREW_PREFIX)/lib
endif

LMODE = dynamic
LMODE2 = dynamic
ifdef STATIC
    LMODE = static
    ifeq (${STATIC}, all)
        LMODE2 = static
    endif
endif

ifeq ($(UNAME_S),Darwin)
    LDLIBMODE =
    LDLIBMODE2 =
    DL_LIB =
    DARWIN_LDFLAGS = -Wl,-no_fixup_chains -Wl,-adhoc_codesign
    DARWIN_FRAMEWORKS = -framework CoreFoundation -framework IOKit
else
    LDLIBMODE = -Wl,-B$(LMODE)
    LDLIBMODE2 = -Wl,-B$(LMODE2)
    DL_LIB = -l dl
endif

# for boost 1.37, add -mt to the boost libraries
LIBS += \
 $(LDLIBMODE) \
   -l boost_filesystem$(BOOST_LIB_SUFFIX) \
   -l boost_program_options$(BOOST_LIB_SUFFIX) \
   -l boost_thread$(BOOST_LIB_SUFFIX) \
   -l boost_chrono$(BOOST_LIB_SUFFIX) \
   -l db_cxx$(BDB_LIB_SUFFIX) \
   -l curl \
   -l ssl \
   -l crypto \
   -l event

ifndef USE_NATIVETOR
  override USE_NATIVETOR = -
endif
ifneq (${USE_NATIVETOR}, -)
  DEFS += -DUSE_NATIVETOR=$(USE_NATIVETOR)
endif

# Include and define surface for the vendored tor sources only; it is kept off
# the global DEFS so tor's headers cannot shadow Innova's. HAVE_CONFIG_H is what
# makes tor's sources pull in orconfig.h; the path macros live in orconfig.h.
# These must precede $(xCFLAGS) on the command line: src/ carries a stale copy of
# tor's ed25519 tree that nothing compiles, and -Isrc would otherwise satisfy
# tor's own "ed25519/donna/..." includes from it.
# ED25519_* are read only under tor/src/ext/ed25519/donna, whose sole compiled
# file is ed25519_tor.c, and TRUNNEL_LOCAL_H only by ext/trunnel/trunnel-impl.h,
# which only the trunnel sources include. Upstream scopes them per file; setting
# them for every tor object has the same effect and keeps the two build systems
# free of per-file flag machinery.
TOR_CPPFLAGS = -DHAVE_CONFIG_H -fwrapv \
    -I$(CURDIR)/tor \
    -I$(CURDIR)/tor/src \
    -I$(CURDIR)/tor/src/ext \
    -I$(CURDIR)/tor/src/ext/trunnel \
    -I$(CURDIR)/tor/src/trunnel \
    -DTRUNNEL_LOCAL_H \
    -DED25519_CUSTOMRANDOM -DED25519_CUSTOMHASH -DED25519_SUFFIX=_donna

# Upstream tor is warning-clean under its own flag set, not under Innova's.
# Quieten the third-party noise rather than editing vendored sources.
TOR_WARNFLAGS = -Wno-unused-parameter -Wno-missing-field-initializers \
    -Wno-implicit-fallthrough -Wno-sign-compare -Wno-unused-but-set-variable

ifndef USE_IPFS
  override USE_IPFS = -
endif
ifneq (${USE_IPFS}, -)
  DEFS += $(addprefix -I,$(CURDIR)/ipfs) -DUSE_IPFS=$(USE_IPFS)
endif

ifndef USE_UPNP
    override USE_UPNP = -
endif
ifneq (${USE_UPNP}, -)
    LIBS += -l miniupnpc
    DEFS += -DUSE_UPNP=$(USE_UPNP)
endif

LIBS+= \
 $(LDLIBMODE2) \
   -l z \
   $(DL_LIB) \
   -l pthread


# Hardening
# Make some classes of vulnerabilities unexploitable in case one is discovered.
#
    # This is a workaround for Ubuntu bug #691722, the default -fstack-protector causes
    # -fstack-protector-all to be ignored unless -fno-stack-protector is used first.
    # see: https://bugs.launchpad.net/ubuntu/+source/gcc-4.5/+bug/691722
    HARDENING=-fno-stack-protector

    # Stack Canaries
    # Put numbers at the beginning of each stack frame and check that they are the same.
    # If a stack buffer if overflowed, it writes over the canary number and then on return
    # when that number is checked, it won't be the same and the program will exit with
    # a "Stack smashing detected" error instead of being exploited.
    HARDENING+=-fstack-protector-all -Wstack-protector

    # Make some important things such as the global offset table read only as soon as
    # the dynamic linker is finished building it. This will prevent overwriting of addresses
    # which would later be jumped to.
    ifneq ($(UNAME_S),Darwin)
        LDHARDENING+=-Wl,-z,relro -Wl,-z,now
    endif

    # Build position independent code to take advantage of Address Space Layout Randomization
    # offered by some kernels.
    # see doc/build-unix.txt for more information.
    ifdef PIE
        HARDENING+=-fPIE
        LDHARDENING+=-pie
    endif

    # -D_FORTIFY_SOURCE=2 does some checking for potentially exploitable code patterns in
    # the source such overflowing a statically defined buffer.
    HARDENING+=-D_FORTIFY_SOURCE=2
#


DEBUGFLAGS=-g


ifeq (${ARCH}, i686)
    EXT_OPTIONS=-msse2
endif


# CXXFLAGS can be specified on the make command line, so we use xCXXFLAGS that only
# adds some defaults in front. Unfortunately, CXXFLAGS=... $(CXXFLAGS) does not work.
xCXXFLAGS=-O2 $(EXT_OPTIONS) -pthread -Wall -Wextra -Wno-ignored-qualifiers -Wno-format -Wno-unused-parameter -Wno-literal-suffix -Wno-deprecated-declarations -Wno-deprecated-copy -std=c++17 \
    $(DEBUGFLAGS) $(DEFS) $(HARDENING) $(CXXFLAGS)

xCFLAGS=-O2 $(EXT_OPTIONS) -pthread -Wall -Wextra -Wno-ignored-qualifiers -Wno-format -Wno-unused-parameter -Wno-deprecated-declarations \
    $(DEBUGFLAGS) $(DEFS) $(HARDENING) $(CFLAGS)

# LDFLAGS can be specified on the make command line, so we use xLDFLAGS that only
# adds some defaults in front. Unfortunately, LDFLAGS=... $(LDFLAGS) does not work.
xLDFLAGS=$(LDHARDENING) $(DARWIN_LDFLAGS) $(LDFLAGS)

ifdef SANITIZE
    xCXXFLAGS += -fsanitize=$(SANITIZE) -fno-omit-frame-pointer
    xCFLAGS += -fsanitize=$(SANITIZE) -fno-omit-frame-pointer
    xLDFLAGS += -fsanitize=$(SANITIZE)
endif

# Lock-order checking and the held-lock watchdog. Off by default: it serialises
# every lock operation through one mutex.
ifdef DEBUG_LOCKORDER
    xCXXFLAGS += -DDEBUG_LOCKORDER
endif

# Vendored tor object list, generated from src/tor/tor_sources.txt by
# contrib/gen_tor_sources.py. TOR_OBJS is undefined when native tor is off.
ifeq (${USE_NATIVETOR}, 1)
include tor/tor_sources.mk
endif

