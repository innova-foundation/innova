	./test_innova --run_test=nullsend_round_key_tests
	./test_innova --run_test=drift_fork_rule_tests

check-settlement-headroom-clamp: test_innova
	./test_innova --run_test=settlement_headroom_clamp_tests

check-block-inv-response: test_innova
	./test_innova --run_test=block_inv_response_tests

check-block-spacing-floor: test_innova
	./test_innova --run_test=block_spacing_floor_tests

check-ms-timestamp: test_innova
	./test_innova --run_test=ms_timestamp_tests

check-ms-timestamp-index: test_innova
	./test_innova --run_test=ms_timestamp_index_tests

